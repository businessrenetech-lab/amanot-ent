# ===========================================================================
# Amanat Business Platform — backend environment variables
# Copy the relevant lines into the project-root ".env" file (same folder as
# package.json). The server + migrate + seed scripts all read from there.
# ===========================================================================

# --- MySQL connection ------------------------------------------------------
# LOCAL DEV (XAMPP / local MySQL):
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=amanat_platform

# HOSTINGER (Business hosting, Node app + MySQL on the same server):
#   Create the DB + user in hPanel > Databases > MySQL Databases, then use the
#   generated names (they are prefixed with your account id, e.g. u123456789_).
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=u123456789_amanat
# DB_PASSWORD=your-strong-db-password
# DB_NAME=u123456789_amanat

# --- API server ------------------------------------------------------------
PORT=8000
# Dev only: the Vite site runs on :3000, so allow it. In production the API and
# site share one origin, so this can be left as your domain or removed.
CORS_ORIGIN=http://localhost:3000

# --- Frontend (Vite) -------------------------------------------------------
# Where the browser should reach the API.
#   Dev:  point at the API dev server.
#   Prod (same Hostinger Node app serving both): leave EMPTY for same-origin.
# If VITE_API_BASE is completely ABSENT, the frontend stays 100% localStorage
# (no network calls) — handy as an offline fallback.
VITE_API_BASE=http://localhost:8000
